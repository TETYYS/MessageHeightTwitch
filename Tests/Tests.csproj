<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <RunSettingsFilePath Condition="'$(OS)' == 'Windows_NT' and '$(PlatformTarget)' != 'x86' and '$(RuntimeIdentifier)' != 'win-x86'">$(MSBuildProjectDirectory)\TestExplorer.runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PlatformTarget)' == 'x86' or '$(PlatformTarget)' == 'x64'">
    <OutputPath>bin\$(Configuration)\$(PlatformTarget)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\$(PlatformTarget)\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MessageHeightTwitch.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Fonts\**\*.ttf;..\Fonts\**\*.otf" Link="Fonts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
	<None Update="Fixtures\ffz-emoji-v2-.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Fixtures\text-measurements.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\skia-*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="TestResults\" />
  </ItemGroup>

</Project>
