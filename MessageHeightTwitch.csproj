<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StackTraceSupport>false</StackTraceSupport>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' or '$(TestHooks)' == 'true'">
    <DefineConstants>$(DefineConstants);TEST</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PlatformTarget)' == 'x86' or '$(PlatformTarget)' == 'x64'">
    <OutputPath>bin\$(Configuration)\$(PlatformTarget)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\$(PlatformTarget)\</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests\**" />
    <Compile Remove="Tools\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="icu.net" Version="4.0.0" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="10.0.0" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageReference Include="HarfBuzzSharp" Version="14.4.0-preview.2.26479.13" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.4.0-preview.2.26479.13" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Fonts\**\*.ttf;Fonts\**\*.otf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Fonts\*.bin" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="BTTVSupportedEmojis.json" />
  </ItemGroup>
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <Content Include="Native\icu78\win-x64\*.dll" Condition="'$(RuntimeIdentifier)' == 'win-x64' or ('$(RuntimeIdentifier)' == '' and ('$(PlatformTarget)' == 'x64' or ('$(PlatformTarget)' != 'x86' and $([System.Environment]::Is64BitOperatingSystem))))" Link="%(Filename)%(Extension)" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    <Content Include="Native\icu78\win-x86\*.dll" Condition="'$(RuntimeIdentifier)' == 'win-x86' or ('$(RuntimeIdentifier)' == '' and ('$(PlatformTarget)' == 'x86' or ('$(PlatformTarget)' != 'x64' and !$([System.Environment]::Is64BitOperatingSystem))))" Link="%(Filename)%(Extension)" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
  </ItemGroup>
    
  <PropertyGroup>
    <LinuxNativeRuntimeIdentifier Condition="$(RuntimeIdentifier.StartsWith('linux-'))">$(RuntimeIdentifier)</LinuxNativeRuntimeIdentifier>
    <LinuxNativeRuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">$(NETCoreSdkRuntimeIdentifier)</LinuxNativeRuntimeIdentifier>
    <UseBundledLinuxIcu Condition="'$(LinuxNativeRuntimeIdentifier)' != ''">true</UseBundledLinuxIcu>
    <LinuxIcuDirectory>$(MSBuildThisFileDirectory)Native/icu78/$(LinuxNativeRuntimeIdentifier)</LinuxIcuDirectory>
  </PropertyGroup>
    
  <ItemGroup Condition="'$(LinuxNativeRuntimeIdentifier)' != ''">
    <DirectPInvoke Include="__Internal!dladdr" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseBundledLinuxIcu)' == 'true'">
    <Content Include="$(LinuxIcuDirectory)/libicudata.so.78;$(LinuxIcuDirectory)/libicuuc.so.78" Link="icu78/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
    
  <Target Name="BuildLinuxIcu" BeforeTargets="BeforeBuild" Condition="'$(UseBundledLinuxIcu)' == 'true' and '$(DesignTimeBuild)' != 'true'"
          Inputs="$(MSBuildThisFileDirectory)Tools/IcuData/Build-IcuData.sh;$(MSBuildThisFileDirectory)Tools/IcuData/items.txt"
          Outputs="$(LinuxIcuDirectory)/libicudata.so.78;$(LinuxIcuDirectory)/libicuuc.so.78">
    <Error Condition="!$([MSBuild]::IsOSPlatform('Linux'))" Text="Build ICU on Linux with a toolchain matching $(LinuxNativeRuntimeIdentifier): sh Tools/IcuData/Build-IcuData.sh --output Native/icu78/$(LinuxNativeRuntimeIdentifier)" />
    <Exec Command="sh &quot;$(MSBuildThisFileDirectory)Tools/IcuData/Build-IcuData.sh&quot; --output &quot;$(LinuxIcuDirectory)&quot;" />
  </Target>
    
  <PropertyGroup>
    <OpenTypeManifest>$(MSBuildThisFileDirectory)Native/opentype/Cargo.toml</OpenTypeManifest>
    <CargoTargetDir>$(MSBuildThisFileDirectory)obj/cargo</CargoTargetDir>
    <CargoTarget Condition="'$(RuntimeIdentifier)' == 'win-x64' or ('$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT' and '$(PlatformTarget)' != 'x86')">x86_64-pc-windows-msvc</CargoTarget>
    <CargoTarget Condition="'$(RuntimeIdentifier)' == 'win-x86' or ('$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT' and '$(PlatformTarget)' == 'x86')">i686-pc-windows-msvc</CargoTarget>
    <CargoTarget Condition="'$(LinuxNativeRuntimeIdentifier)' == 'linux-x64'">x86_64-unknown-linux-gnu</CargoTarget>
    <CargoTarget Condition="'$(LinuxNativeRuntimeIdentifier)' == 'linux-musl-x64'">x86_64-unknown-linux-musl</CargoTarget>
    <CargoLinuxOptions Condition="$(CargoTarget.Contains('-linux-'))">--config &quot;target.$(CargoTarget).rustflags=['-C', 'target-feature=-crt-static']&quot;</CargoLinuxOptions>
    <OpenTypeLibrary Condition="$(CargoTarget.Contains('windows'))">mht_opentype.dll</OpenTypeLibrary>
    <OpenTypeLibrary Condition="!$(CargoTarget.Contains('windows'))">libmht_opentype.so</OpenTypeLibrary>
  </PropertyGroup>
    
  <ItemGroup>
    <Content Include="$(CargoTargetDir)/$(CargoTarget)/release/$(OpenTypeLibrary)" Link="$(OpenTypeLibrary)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildOpenTypeCrate" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(CargoTarget)' == ''" Text="Native/opentype has no Cargo target for runtime identifier '$(RuntimeIdentifier)'." />
    <Exec Command="cargo build --release --locked --manifest-path &quot;$(OpenTypeManifest)&quot; --target $(CargoTarget) --target-dir &quot;$(CargoTargetDir)&quot; $(CargoLinuxOptions)" />
  </Target>
  <Target Name="RemoveNativePackageSymbols" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(Extension)' == '.pdb'" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
